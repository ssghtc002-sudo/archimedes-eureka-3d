  "dialogue": [
    {
      "id": "line_01",
      "beatId": "beat_1_royal_crown_hook",
      "speaker": "king",
      "start": 0.22,
      "end": 2.45,
      "text": "Archimedes! Is my crown pure gold—or fake?"
    },
    {
      "id": "line_02",
      "beatId": "beat_1_royal_crown_hook",
      "speaker": "narrator",
      "start": 2.60,
      "end": 4.65,
      "text": "One catch—melt the King's crown, and you're history!"
    },
    {
      "id": "line_03",
      "beatId": "beat_2_ruler_struggle",
      "speaker": "archimedes",
      "start": 4.95,
      "end": 7.35,
      "text": "A gold bar is easy—but how do you measure spiky curves?"
    },
    {
      "id": "line_04",
      "beatId": "beat_2_ruler_struggle",
      "speaker": "narrator",
      "start": 7.50,
      "end": 9.65,
      "text": "Rulers fail, calipers slip—and geometry gives up!"
    },
    {
      "id": "line_05",
      "beatId": "beat_3_bathtub_eureka",
      "speaker": "narrator",
      "start": 9.95,
      "end": 12.45,
      "text": "Then Archimedes hops into a brim-full bath—splash!"
    },
    {
      "id": "line_06",
      "beatId": "beat_3_bathtub_eureka",
      "speaker": "archimedes",
      "start": 12.60,
      "end": 15.05,
      "text": "Eureka! My body pushes out its exact volume of water!"
    },
    {
      "id": "line_07",
      "beatId": "beat_4_dual_tank_trap",
      "speaker": "narrator",
      "start": 15.35,
      "end": 17.85,
      "text": "Cheat with lighter silver—and the crown must be bulkier!"
    },
    {
      "id": "line_08",
      "beatId": "beat_4_dual_tank_trap",
      "speaker": "archimedes",
      "start": 18.00,
      "end": 20.25,
      "text": "Look! The crown spills way more water than pure gold!"
    },
    {
      "id": "line_09",
      "beatId": "beat_5_busted_buoyancy",
      "speaker": "king",
      "start": 20.55,
      "end": 22.80,
      "text": "Busted! The sneaky goldsmith stuffed silver inside!"
    },
    {
      "id": "line_10",
      "beatId": "beat_5_busted_buoyancy",
      "speaker": "narrator",
      "start": 22.95,
      "end": 25.25,
      "text": "Upward buoyant push equals the weight of displaced water!"
    },
    {
      "id": "line_11",
      "beatId": "beat_6_syracuse_finale",
      "speaker": "narrator",
      "start": 25.55,
      "end": 27.65,
      "text": "That one bath unlocked why giant steel ships float!"
    },
    {
      "id": "line_12",
      "beatId": "beat_6_syracuse_finale",
      "speaker": "archimedes",
      "start": 27.80,
      "end": 29.75,
      "text": "Never underestimate a genius—and a bubble bath!"
    }
  ],
